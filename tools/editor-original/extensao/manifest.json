{
  "manifest_version": 3,
  "name": "Minerador Viral",
  "version": "1.2.0",
  "description": "Encontra os vídeos que mais performaram em perfis do Instagram, TikTok e YouTube Shorts, baixa em massa e manda links do YouTube para o Editor em Massa.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "downloads", "unlimitedStorage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "http://127.0.0.1:47811/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "action": {
    "default_title": "Abrir o Minerador Viral",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
