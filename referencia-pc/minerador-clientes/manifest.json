{
  "manifest_version": 3,
  "name": "Minerador de Clientes",
  "short_name": "Minerador Clientes",
  "version": "1.0.0",
  "description": "Lista lojas do Google Maps da sua cidade (nota, avaliações, fotos, site, telefone) e mostra quais têm chance de comprar um site.",
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
  "action": { "default_title": "Minerador de Clientes", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
  "side_panel": { "default_path": "painel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*", "<all_urls>"]
}
