{
  "manifest_version": 3,
  "name": "Copiador de Sites",
  "version": "1.3.0",
  "description": "Copia sites (com autorização do dono) para uma pasta que funciona offline, edita textos, imagens, cores e seções, exporta para a Lovable/GitHub e copia só um componente do site.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copiador de Sites",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "gravador.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "registro.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}